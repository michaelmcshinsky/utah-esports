# Netlify's Next.js adapter (OpenNext) requires public hoisting with pnpm,
# otherwise the deployed function bundle omits the `next` package and every
# request crashes with "Cannot find module 'next/dist/server/lib/start-server.js'".
# https://opennext.js.org/netlify#pnpm-support
# pnpm 12 reads these from pnpm-workspace.yaml; these lines cover older pnpm.
public-hoist-pattern[]=*
node-linker=hoisted

# Keep build scripts explicit (pnpm 10+ blocks them by default).
# allowBuilds lives in pnpm-workspace.yaml.
