# --- Database (Supabase or local docker-compose Postgres+PostGIS) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/utah_esports

# --- Supabase (project settings -> API) ---
# Leave empty for local dev without Supabase — sign-in hides itself gracefully.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3131

# --- start.gg (developer.start.gg -> personal access token) ---
STARTGG_TOKEN=

# --- Email (resend.com) ---
RESEND_API_KEY=
# From address for outbound mail (defaults to onboarding@resend.dev).
EMAIL_FROM=

# --- Discord bot (discord.com/developers/applications) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Server (guild) id — commands register globally when empty.
DISCORD_GUILD_ID=

# --- Trigger.dev (trigger.dev project -> secrets) ---
TRIGGER_SECRET_KEY=
